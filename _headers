/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self' 'sha256-Yt1Y4VdxY5uj6QvjwVBguuGWrGfDjQw7V3hH7xz0urE='; connect-src 'self'; form-action 'self' https://buy.stripe.com https://checkout.stripe.com; upgrade-insecure-requests

/service-worker.js
  Cache-Control: no-cache

/config.js
  Cache-Control: no-cache

/api/*
  Cache-Control: no-store

/terms.html
  Link: <https://foodmyway.app/terms.html>; rel="canonical"
